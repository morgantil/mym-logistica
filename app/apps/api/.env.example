# Copiar a .env y completar. Ver README.md para cómo obtener cada valor.

# Postgres en Neon (ver README — sección "Base de datos")
DATABASE_URL="postgresql://usuario:password@host.neon.tech/mym?sslmode=require"

PORT=3000

# URL del frontend — a donde redirige /auth/google/callback una vez logueado
FRONTEND_URL="http://localhost:5173"

# JWT (login propio)
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="otro-secreto-largo-distinto-al-de-arriba"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth (login con Google) — Google Cloud Console > Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Redis (BullMQ) — Upstash o local
REDIS_URL="redis://localhost:6379"

# SimpliRoute — se completa cuando se gestione el acceso (DOCUMENTO TECNICO.md sección 4)
SIMPLIROUTE_API_URL=""
SIMPLIROUTE_API_KEY=""
SIMPLIROUTE_MOCK="true"

# Cloudflare R2 (almacenamiento de archivos)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="mym-archivos"
