// Esquema inicial — ver DOCUMENTO TECNICO.md en la raíz del proyecto para las decisiones
// que explican cada convención usada acá (borrado lógico, auditoría, roles combinables, etc.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Convenciones aplicadas en (casi) todos los modelos:
//
// - Borrado lógico: `eliminadoEn` (null = activo). Ningún modelo hace delete físico.
// - Auditoría de quién hizo qué: `creadoPorId` / `actualizadoPorId` / `eliminadoPorId`
//   se guardan como el id de Usuario en texto plano, SIN relación Prisma explícita.
//   Es intencional: declarar la relación en ambos sentidos (Usuario <-> cada modelo)
//   multiplicaría decenas de relaciones nombradas sin aportar nada — la trazabilidad
//   completa (quién, cuándo, valor anterior/nuevo) vive en RegistroAuditoria, que es
//   la fuente de verdad real. Estos campos son un atajo de lectura rápida.
// - `version` (bloqueo optimista) solo se agrega donde hay riesgo real de edición
//   concurrente. Se empieza por Pedido (Operaciones y Logística lo tocan a la vez).
// ---------------------------------------------------------------------------

enum Rol {
  OPERACIONES
  LOGISTICA
  ADMINISTRACION
  FACTURACION
}

enum TipoServicio {
  PANAL
  MEDICAMENTO
}

// Qué tipo de servicio maneja un Cliente (farmacia) — distinto de
// TipoServicio (siempre uno solo por Pedido): un Cliente puede manejar
// los dos (ej. Bella Vista importa tanto pañales como medicamentos).
enum TipoServicioCliente {
  PANAL
  MEDICAMENTO
  AMBOS
}

// Clasificación de un pedido de medicamentos para facturación — ver
// @mym/shared-types para la regla completa (Bolsa+Bulto en el mismo pedido
// se factura como Bulto).
enum TipoEnvase {
  BOLSA
  BULTO
}

// DOCUMENTO FUNCIONAL.md §19
enum EstadoPedido {
  SIN_ASIGNAR
  COORDINADO
  EN_TRANSITO
  ENTREGADO
  ENTREGA_FALLIDA
  CANCELADO
}

enum EstadoValidacion {
  PENDIENTE
  VALIDO
  CON_ERRORES
}

enum EstadoSimpliroute {
  NO_ENVIADO
  ENVIADO
  NO_ENCONTRADO
  ERROR
}

enum EstadoImportacion {
  PROCESANDO
  COMPLETADA
  COMPLETADA_CON_ERRORES
  FALLIDA
}

enum EstadoGrupoFacturacion {
  BORRADOR
  CONFIRMADO
}

enum AccionAuditoria {
  CREAR
  ACTUALIZAR
  BORRAR
  RESTAURAR
}

// ---------------------------------------------------------------------------
// Usuarios, roles y permisos por cliente
// ---------------------------------------------------------------------------

model Usuario {
  id           String  @id @default(uuid())
  email        String  @unique
  nombre       String
  passwordHash String? // null si el usuario solo usa Google OAuth
  googleId     String? @unique
  roles        Rol[] // combinables — ver DOCUMENTO TECNICO.md sección 2
  activo       Boolean @default(true)

  // Preferencia personal de la grilla de Pedidos — ids de columna que este
  // usuario fijó como "importantes" (van primero, el resto sigue en el orden
  // por defecto). Sin drag-and-drop: el orden dentro de las fijas es el orden
  // en que las fue marcando. Vacío = usa el orden por defecto de la grilla.
  columnasFijasPedidos String[] @default([])

  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
  eliminadoEn   DateTime?

  clientesPermitidos UsuarioCliente[]
  sesiones           SesionRefreshToken[]

  @@map("usuarios")
}

// Permite revocar sesiones de verdad (no solo esperar a que el JWT expire solo)
// — DOCUMENTO TECNICO.md sección 2, "Revocación de sesiones". Se guarda el HASH
// del refresh token, nunca el token en texto plano (igual que una contraseña:
// si alguien lee esta tabla, no puede reusar los tokens). Rotación en cada
// refresh: el token usado queda revocado y se crea uno nuevo.
model SesionRefreshToken {
  id         String    @id @default(uuid())
  usuarioId  String
  tokenHash  String    @unique
  creadoEn   DateTime  @default(now())
  expiraEn   DateTime
  revocadoEn DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesiones_refresh_token")
}

// Permisos por cliente (§ Permisos por cliente en DOCUMENTO TECNICO.md):
// si un usuario no tiene ninguna fila acá, se asume que ve todos los clientes.
// Si tiene al menos una, queda restringido a esos.
model UsuarioCliente {
  usuarioId String
  clienteId String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@id([usuarioId, clienteId])
  @@map("usuarios_clientes")
}

// ---------------------------------------------------------------------------
// Cliente (farmacia que contrata el servicio) — nunca confundir con Destinatario.
// DOCUMENTO FUNCIONAL.md §2, §20
// ---------------------------------------------------------------------------

model Cliente {
  id                String              @id @default(uuid())
  nombre            String
  // patrones de texto para detectar el cliente en el nombre del archivo Excel
  // (§5 funcional, ej. "BIOSINTESIS", "BELLA VISTA", "FARMAPAL")
  patronesDeteccion String[]
  activo            Boolean             @default(true)
  // Qué tipo de servicio maneja este cliente — determina reglas de
  // facturación (ej. Bolsa/Bulto solo aplica a medicamentos). Default
  // PANAL porque hoy todos los clientes reales son de pañales (Etapa 1);
  // clientes que también manejen medicamentos (ej. Bella Vista) se marcan
  // "AMBOS" a mano desde esta pantalla, no se asume.
  tipoServicio      TipoServicioCliente @default(PANAL)

  creadoEn         DateTime  @default(now())
  actualizadoEn    DateTime  @updatedAt
  creadoPorId      String?
  actualizadoPorId String?
  eliminadoEn      DateTime?
  eliminadoPorId   String?

  tarifas                      TarifaCliente[]
  destinatarios                Destinatario[]
  pedidos                      Pedido[]
  gruposFacturacion            GrupoFacturacion[]
  importaciones                ImportacionExcel[]
  usuariosPermitidos           UsuarioCliente[]
  perfilImportacion            PerfilImportacion?
  combinacionesComoMedicamento CombinacionUnificacionClientes[] @relation("CombinacionMedicamento")
  combinacionesComoPanal       CombinacionUnificacionClientes[] @relation("CombinacionPanal")

  @@map("clientes")
}

// Mapeo de columnas de Excel confirmado para este cliente — DOCUMENTO TECNICO.md:
// "Importador de Excel: mapeo de columnas genérico y data-driven". La primera
// vez que se importa un archivo de un cliente, este mapeo no existe: se intenta
// resolver automático (diccionario de sinónimos) y lo que falte lo confirma un
// usuario una vez. A partir de ahí queda acá y las próximas importaciones de
// ese mismo cliente no vuelven a preguntar nada.
model PerfilImportacion {
  id            String @id @default(uuid())
  clienteId     String @unique
  mapeoColumnas Json // Record<CampoCanonico, string> — ver modulos/importadores/domain/campo-canonico.ts

  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt
  creadoPorId      String?
  actualizadoPorId String?

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@map("perfiles_importacion")
}

// Tarifas por cliente y zona tarifaria, con vigencia para mantener histórico
// (§23 funcional). "Zona tarifaria" es genérica y configurable (no un enum
// fijo CABA/Provincia) — el documento funcional v6 pide poder tener CABA +
// Cordón 1/2/3, y que la relación Localidad → zona sea configurable, sin
// tocar código para agregar/renombrar una zona. Ver ZonaTarifaria más abajo.
model TarifaCliente {
  id              String       @id @default(uuid())
  clienteId       String
  zonaTarifariaId String
  // Guia_Desarrollo_Logica_Facturacion_Arbet.docx paso 5: "Pañales: Cliente +
  // Zona tarifaria. Medicamentos: Cliente + Zona tarifaria + Bolsa/Bulto." —
  // antes de esta migración, TarifaCliente no tenía dimensión de tipo de
  // servicio (solo existían tarifas de pañales, únicas por cliente+zona).
  // Default PANAL + tipoEnvase null para las tarifas ya cargadas (representan
  // exactamente lo que eran: tarifas de pañales, la única Etapa en uso hasta
  // ahora). tipoEnvase solo aplica cuando tipoServicio = MEDICAMENTO.
  tipoServicio    TipoServicio @default(PANAL)
  tipoEnvase      TipoEnvase?
  monto           Decimal      @db.Decimal(12, 2)
  vigenciaDesde   DateTime
  vigenciaHasta   DateTime?

  creadoEn       DateTime  @default(now())
  creadoPorId    String?
  eliminadoEn    DateTime?
  eliminadoPorId String?

  cliente       Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  zonaTarifaria ZonaTarifaria @relation(fields: [zonaTarifariaId], references: [id])

  @@index([clienteId, zonaTarifariaId, tipoServicio, tipoEnvase, vigenciaDesde])
  @@map("tarifas_cliente")
}

// ---------------------------------------------------------------------------
// Destinatario (padrón) — persona final que recibe el pedido. §2, §8 funcional
// ---------------------------------------------------------------------------

model Destinatario {
  id                   String   @id @default(uuid())
  clienteId            String
  numeroAfiliado       String
  nombre               String
  direccion            String
  direccionNormalizada String?
  localidad            String
  telefono             String?
  simplirouteId        String?
  latitud              Decimal? @db.Decimal(9, 6)
  longitud             Decimal? @db.Decimal(9, 6)

  creadoEn         DateTime  @default(now())
  actualizadoEn    DateTime  @updatedAt
  creadoPorId      String?
  actualizadoPorId String?
  eliminadoEn      DateTime?
  eliminadoPorId   String?

  cliente Cliente  @relation(fields: [clienteId], references: [id])
  pedidos Pedido[]

  @@unique([clienteId, numeroAfiliado])
  @@map("destinatarios")
}

// ---------------------------------------------------------------------------
// Zonas, choferes y vehículos — §12, §13 funcional.
//
// Decisión 2026-08-25/26 (ver DOCUMENTO TECNICO.md historial): revierte el
// diseño anterior (Zona/Chofer/ZonaChofer configurados a mano acá). Ahora
// SimpliRoute es la fuente de verdad — estas tres tablas son un CACHE de
// solo lectura interna, refrescado por ZonasChoferesService contra
// LogisticaProviderPort (nunca se escribe acá directamente desde un
// formulario). Altas/ediciones de Chofer y Vehículo van derecho a la API de
// SimpliRoute (tiene CRUD completo); Zonas es de solo lectura pública en
// SimpliRoute (sin POST/PUT/PATCH/DELETE), así que acá también es solo
// lectura — cualquier alta/edición de zona se sigue haciendo en SimpliRoute.
// `id` es el ID numérico real de SimpliRoute, no un uuid propio.
// ---------------------------------------------------------------------------

model ZonaSimpliRouteCache {
  id             Int      @id
  nombre         String
  habilitada     Boolean
  dias           String[] // schedules tal cual los nombra SimpliRoute (Monday, Tuesday, ...)
  poligono       Json // [{ lat: string, lng: string }, ...] tal cual lo devuelve GET /v1/zones/
  vehiculosIds   Int[] // Vehicle IDs de SimpliRoute asignados a esta zona
  sincronizadoEn DateTime @default(now())

  @@map("zonas_simpliroute_cache")
}

model ChoferSimpliRouteCache {
  id             Int      @id // SimpliRoute User/Driver id
  nombre         String
  username       String
  telefono       String?
  email          String?
  activo         Boolean
  sincronizadoEn DateTime @default(now())

  @@map("choferes_simpliroute_cache")
}

model VehiculoSimpliRouteCache {
  id                     Int      @id
  nombre                 String
  patente                String?
  choferPredeterminadoId Int? // Vehicle.default_driver
  estado                 String
  sincronizadoEn         DateTime @default(now())

  @@map("vehiculos_simpliroute_cache")
}

// ---------------------------------------------------------------------------
// Zonas tarifarias — §10 funcional (v6). NO es lo mismo que Zona/Chofer de
// arriba (eso es logística: a qué chofer le toca un pedido). Esto es
// facturación: qué tarifa aplica. Se modela como tabla, no enum, porque el
// documento pide explícitamente "la relación Localidad → Cordón deberá ser
// configurable y no quedar fija en código" — agregar una zona nueva (o
// renombrar una) es una fila nueva, no un deploy.
// ---------------------------------------------------------------------------

model ZonaTarifaria {
  id     String  @id @default(uuid())
  nombre String  @unique // ej. "CABA", "Cordón 1", "Cordón 2", "Cordón 3"
  activa Boolean @default(true)

  eliminadoEn DateTime?

  localidades LocalidadZonaTarifaria[]
  partidos    PartidoZonaTarifaria[]
  tarifas     TarifaCliente[]
  pedidos     Pedido[]

  @@map("zonas_tarifarias")
}

// Mapeo Localidad (texto normalizado) → ZonaTarifaria, configurable por
// Administración. CABA no necesita entradas acá (se resuelve directo por la
// clasificación CABA/Provincia de GeorefArAdapter) — esta tabla es para
// decidir a qué Cordón pertenece cada localidad de Provincia.
model LocalidadZonaTarifaria {
  id              String @id @default(uuid())
  localidad       String @unique
  zonaTarifariaId String

  zonaTarifaria ZonaTarifaria @relation(fields: [zonaTarifariaId], references: [id])

  @@map("localidades_zonas_tarifarias")
}

// Mapeo Partido/Municipio (GBA) → ZonaTarifaria (Cordón) — decisión
// 2026-09-08: las Zonas de SimpliRoute cruzan varios partidos reales cada
// una (comprobado geocodificando los vértices de sus polígonos contra la
// API oficial — "Sur Lanús" cae en 5 partidos distintos, "Oeste largo" en
// 9 — están dibujadas para logística, no para separar zonas de precio), así
// que asignarles un Cordón único da resultados imprecisos (por eso se sacó
// del sistema el mapeo Zona de SimpliRoute → Cordón que existía antes, ver
// DOCUMENTO TECNICO.md historial 2026-09-08). El partido en cambio es un
// límite administrativo exacto, y ya lo devuelve GeorefArAdapter (el mismo
// que resuelve CABA/Provincia) — mapear por partido (~29 en todo el
// conurbano) es mucho más preciso, y mucho menos trabajo que cargar cada
// localidad suelta. Se prioriza sobre el mapeo por Localidad al resolver un
// pedido (ver ZonasTarifariasService.resolverParaPedido).
model PartidoZonaTarifaria {
  partido         String @id
  zonaTarifariaId String

  zonaTarifaria ZonaTarifaria @relation(fields: [zonaTarifariaId], references: [id])

  @@map("partidos_zonas_tarifarias")
}

// ---------------------------------------------------------------------------
// Importación de Excel — §4, §5, §6 funcional
// ---------------------------------------------------------------------------

model ImportacionExcel {
  id            String            @id @default(uuid())
  clienteId     String? // null = "Cliente sin identificar" hasta que el usuario lo confirme
  nombreArchivo String
  urlArchivo    String? // key/ruta en el bucket (Cloudflare R2) — null hasta que se configuren credenciales R2 (ver .env.example)
  estado        EstadoImportacion @default(PROCESANDO)
  totalFilas    Int?
  filasConError Int?
  usuarioId     String

  creadoEn DateTime @default(now())

  cliente Cliente? @relation(fields: [clienteId], references: [id])
  pedidos Pedido[]

  @@map("importaciones_excel")
}

// ---------------------------------------------------------------------------
// Pedido — unidad central de trabajo. §7, §14-§19 funcional
// ---------------------------------------------------------------------------

model Pedido {
  id             String  @id @default(uuid())
  // N.º de Pedido interno — documento funcional v6 §8.2: "mismo número en
  // todas las etiquetas del pedido". Secuencial y legible, distinto del `id`
  // (UUID interno, no pensado para mostrarse en una etiqueta impresa).
  numero         Int     @unique @default(autoincrement())
  clienteId      String
  destinatarioId String
  importacionId  String?

  numeroAfiliado       String // snapshot al momento de importar
  direccionOriginal    String // tal cual vino en el Excel
  direccionUsada       String // la que efectivamente se usa para zona/planificación (§11 funcional)
  direccionNormalizada String?
  localidad            String
  zonaTarifariaId      String?

  fechaProgramada      DateTime
  fechaEntregaEfectiva DateTime?

  tipoServicio      TipoServicio
  estado            EstadoPedido      @default(SIN_ASIGNAR)
  estadoValidacion  EstadoValidacion  @default(PENDIENTE)
  estadoSimpliroute EstadoSimpliroute @default(NO_ENVIADO)

  // ID numérico de SimpliRoute (Zone.id / driver id resuelto vía vehículo de
  // la zona — ver ZonasChoferesService.resolverZonaChofer), guardado como
  // string por consistencia con el resto del modelo. `zonaNombre`/
  // `choferNombre` son snapshot al momento de resolver (mismo criterio que
  // `numeroAfiliado` arriba) — así un pedido sigue mostrando su zona/chofer
  // aunque el cache de SimpliRoute cambie o esa zona ya no exista más
  // adelante. Pedidos anteriores al 2026-08-26 tienen acá `null` (el ID
  // apuntaba a las tablas Zona/Chofer manuales ya eliminadas) pero conservan
  // el nombre en el snapshot — ver migración `zonas_choferes_desde_simpliroute`.
  zonaId               String?
  zonaNombre           String?
  choferId             String?
  choferNombre         String?
  // Snapshot de la zona/chofer que se había asignado ANTES de enviar (con las
  // coordenadas del Client que SimpliRoute tenía guardadas, potencialmente
  // desactualizadas) — solo se completan si el recálculo post-envío con la
  // coordenada real (ver latitudEntrega) dio una zona distinta y se corrigió
  // `zonaId`/`choferId` de arriba. Sirven para medir cuántas veces pasó esto
  // (liquidación a transportistas §31/§4.2) — no se tocan si coincidió.
  zonaPreEnvioId       String?
  zonaPreEnvioNombre   String?
  choferPreEnvioId     String?
  choferPreEnvioNombre String?
  // Coordenada real de la entrega, geocodificada por SimpliRoute al crear la
  // Visit con `direccionUsada` (confirmado con pruebas reales 2026-09-03) —
  // independiente de las coordenadas que tenga guardadas el Client. Null
  // hasta que el pedido se envía, o si SimpliRoute no pudo geocodificar nada.
  latitudEntrega       Float?
  longitudEntrega      Float?
  geocodeAlert         String?
  bultos               Int?
  remito               String?
  ticket               String? // opcional — Farmapal (§4 funcional)
  simplirouteId        String?
  observaciones        String?
  // Cuándo se imprimió por última vez alguna etiqueta de este pedido — null =
  // nunca. §8.1 funcional v6: "estado de impresión de la etiqueta" en la
  // pantalla de Embalaje y Despacho. No impide reimprimir, solo informa.
  etiquetaImpresaEn    DateTime?

  grupoFacturacionId String?
  reglaAplicada      String? // "2x1" | "UNIFICADA" | "INDIVIDUAL" — informativo, el detalle vive en GrupoFacturacion

  version Int @default(0) // bloqueo optimista — ver nota de convenciones arriba

  creadoEn         DateTime  @default(now())
  actualizadoEn    DateTime  @updatedAt
  creadoPorId      String?
  actualizadoPorId String?
  eliminadoEn      DateTime?
  eliminadoPorId   String?

  cliente          Cliente           @relation(fields: [clienteId], references: [id])
  destinatario     Destinatario      @relation(fields: [destinatarioId], references: [id])
  importacion      ImportacionExcel? @relation(fields: [importacionId], references: [id])
  zonaTarifaria    ZonaTarifaria?    @relation(fields: [zonaTarifariaId], references: [id])
  grupoFacturacion GrupoFacturacion? @relation(fields: [grupoFacturacionId], references: [id])
  productos        Producto[]

  @@index([clienteId, estado, fechaProgramada])
  @@index([destinatarioId])
  @@map("pedidos")
}

// Una línea del Excel = un producto. Varios productos + mismo afiliado/dirección/fecha
// se agrupan en un mismo Pedido (§7 funcional).
model Producto {
  id          String  @id @default(uuid())
  pedidoId    String
  codigo      String? // EAN
  descripcion String
  cantidad    Int
  // Nº de orden/ticket del sistema de origen (ej. Farmanet) para ESTA línea
  // puntual — antes se guardaba uno solo a nivel del pedido entero (la
  // primera línea del grupo pisaba a las demás si dos líneas venían de
  // órdenes de origen distintas, aunque se agruparan en el mismo pedido
  // por misma dirección/fecha). Decisión 2026-09-07: agrupar por pedido
  // sigue siendo correcto para facturación (documento funcional §7), pero
  // la trazabilidad de a qué orden de origen corresponde cada línea no se
  // puede perder.
  ticket      String?

  eliminadoEn DateTime?

  // Solo relevante para líneas de medicamentos — Guia_Desarrollo_Logica_
  // Facturacion_Arbet.docx paso 2. Null para pañales (y para medicamentos
  // todavía no clasificados). No existe importador de medicamentos aún —
  // se carga a mano o vía script hasta que se construya (TEMAS_PENDIENTES.md §13.5).
  tipoEnvase TipoEnvase?

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@map("productos")
}

// ---------------------------------------------------------------------------
// Facturación — §21-§32 funcional
// ---------------------------------------------------------------------------

// Historial de porcentaje aplicado a entregas unificadas, con vigencia (mismo
// criterio que TarifaCliente). Decisión 2026-09-08 (ping-pong con Leonardo):
// el documento Arbet asume pañales siempre al 100% + un % adicional de
// medicamentos, pero el negocio real cobra un % configurable de CADA lado
// ("se cobra un % de pañal y uno de medicamento") — por eso dos columnas en
// vez de una. 100/100 reproduce el caso "tal cual viene del documento".
model PorcentajeSegundoServicio {
  id                    String    @id @default(uuid())
  clienteId             String
  porcentajePanal       Decimal   @db.Decimal(5, 2)
  porcentajeMedicamento Decimal   @db.Decimal(5, 2)
  vigenciaDesde         DateTime
  vigenciaHasta         DateTime?

  creadoEn    DateTime  @default(now())
  creadoPorId String?
  eliminadoEn DateTime?

  @@map("porcentajes_segundo_servicio")
}

// Combinaciones habilitadas de unificación ENTRE clientes distintos (Guia_
// Desarrollo_Logica_Facturacion_Arbet.docx paso 4: "la combinación está
// habilitada"). No confundir con la unificación interna de un cliente AMBOS
// (ej. Bella Vista, que maneja pañales y medicamentos ella misma) — esa ya
// funciona sola con el motor de un solo cliente, sin necesitar esta tabla
// (decisión 2026-09-08: "solo entre ellos se pueden unificar... con el resto
// no, es un flujo exclusivo" — Leonardo). Esta tabla es solo para el caso
// cruzado: un cliente que solo maneja medicamentos (ej. Farmaet) unificando
// con un cliente que solo maneja pañales (ej. Biosíntesis/Farmapal).
model CombinacionUnificacionClientes {
  id                   String  @id @default(uuid())
  clienteMedicamentoId String
  clientePanalId       String
  activa               Boolean @default(true)

  creadoEn    DateTime  @default(now())
  creadoPorId String?
  eliminadoEn DateTime?

  clienteMedicamento Cliente @relation("CombinacionMedicamento", fields: [clienteMedicamentoId], references: [id], onDelete: Cascade)
  clientePanal       Cliente @relation("CombinacionPanal", fields: [clientePanalId], references: [id], onDelete: Cascade)

  @@unique([clienteMedicamentoId, clientePanalId])
  @@map("combinaciones_unificacion_clientes")
}

// Liquidación a transportistas (documento funcional v6, alcance nuevo) —
// decisión 2026-08-26: en vez de un valor fijo en código, es un monto
// configurable con historial de vigencia (mismo patrón que
// PorcentajeSegundoServicio/TarifaCliente), editable por el rol Facturación.
// No tiene clienteId: es un monto único por viaje realizado, sin distinguir
// cliente ni tipo de entrega (regla simple confirmada por Leonardo: "se paga
// por viaje realizado, sin 2×1 ni entrega unificada"). El *cálculo* de
// cuántos viajes hizo cada chofer (para multiplicar por este monto) todavía
// no está construido — depende de sincronizar datos de Rutas/Viajes desde
// SimpliRoute, que hoy no se sincronizan (ver TEMAS_PENDIENTES.md sección 2).
model TarifaTransportista {
  id            String    @id @default(uuid())
  monto         Decimal   @db.Decimal(12, 2)
  vigenciaDesde DateTime
  vigenciaHasta DateTime?

  creadoEn    DateTime  @default(now())
  creadoPorId String?
  eliminadoEn DateTime?

  @@map("tarifas_transportista")
}

// Agrupa los pedidos que comparten un viaje facturable (2x1, unificación, o individual).
// Los pedidos NUNCA se fusionan ni se borran — solo se relacionan acá (§32 funcional).
model GrupoFacturacion {
  id        String                 @id @default(uuid())
  clienteId String
  mes       Int
  anio      Int
  estado    EstadoGrupoFacturacion @default(BORRADOR) // vista previa hasta confirmar

  reglaAplicada                 String // "2x1" | "UNIFICADA" | "INDIVIDUAL"
  tarifaUtilizada               Decimal? @db.Decimal(12, 2)
  porcentajeAplicado            Decimal? @db.Decimal(5, 2)
  // Detalle de porcentajes en un viaje UNIFICADA — reemplaza a
  // porcentajeAplicado (que solo puede guardar un número) ahora que pañal y
  // medicamento tienen cada uno su propio % configurable. porcentajeAplicado
  // queda sin usar para filas nuevas de UNIFICADA (se deja en la tabla, no se
  // borra, por las filas históricas ya confirmadas). Null en 2x1/INDIVIDUAL,
  // igual que antes.
  porcentajePanalAplicado       Decimal? @db.Decimal(5, 2)
  porcentajeMedicamentoAplicado Decimal? @db.Decimal(5, 2)
  // Para una unificación ENTRE clientes distintos (combinación habilitada):
  // referencia informativa al pedido "socio" (del otro cliente) y a qué
  // cliente pertenece — no forma parte de este GrupoFacturacion (cada
  // cliente se factura por separado, por su propia tarifa/%), es solo
  // trazabilidad para auditar qué entrega compartida generó esta unificación.
  pedidoSocioId                 String?
  clienteSocioId                String?
  importeCalculado              Decimal  @db.Decimal(12, 2)

  confirmadoEn    DateTime?
  confirmadoPorId String?

  creadoEn DateTime @default(now())

  cliente Cliente  @relation(fields: [clienteId], references: [id])
  pedidos Pedido[]

  @@index([clienteId, anio, mes, estado])
  @@map("grupos_facturacion")
}

// ---------------------------------------------------------------------------
// Auditoría universal — DOCUMENTO TECNICO.md sección 2. Append-only, nunca se edita/borra.
// ---------------------------------------------------------------------------

model RegistroAuditoria {
  id            String          @id @default(uuid())
  entidad       String // nombre del modelo, ej. "Pedido"
  entidadId     String
  accion        AccionAuditoria
  usuarioId     String?
  valorAnterior Json?
  valorNuevo    Json?
  creadoEn      DateTime        @default(now())

  @@index([entidad, entidadId])
  @@index([usuarioId])
  @@map("registros_auditoria")
}
