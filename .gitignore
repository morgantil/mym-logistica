# Dependencias
node_modules/

# Builds
dist/
build/
.turbo/
*.tsbuildinfo

# Variables de entorno — NUNCA commitear credenciales (connection strings, secrets, API keys)
.env
.env.*
!.env.example

# Prisma
apps/api/prisma/migrations/dev.db*

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Sistema operativo / editores
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Configuración local de Claude Code (permisos, tareas programadas) — no es
# código del proyecto, es específico de cada máquina/sesión.
.claude/

# Tests / coverage
coverage/

# Archivos temporales
*.tmp
*.temp

# Datos reales de clientes/pacientes (Excel de OSDE, capturas, etc.) — nunca
# se commitean, solo se usan localmente para probar el importador.
drive */
INPUT/

# Artefactos de sesiones de QA con el plugin de Playwright (capturas, logs de
# consola, snapshots) — nunca son entregables, solo evidencia de una corrida.
.playwright-mcp/
.vercel
.env*
